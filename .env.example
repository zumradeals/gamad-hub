APP_ENV=development

DATABASE_URL=postgresql://gamad_user:change_me@localhost:5432/gamad_hub
POSTGRES_DB=gamad_hub
POSTGRES_USER=gamad_user
POSTGRES_PASSWORD=change_me

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

API_PORT=4000
WEB_PORT=3000
# Optionnel (SSR hors navigateur). Le Core utilise /api en même origine dans le navigateur.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Nginx : gamad-hub.conf (HTTP seul, défaut) ou gamad-hub-tls.conf (HTTP+HTTPS).
# Avec TLS : exporter NGINX_CONF_FILE et ajouter -f docker/docker-compose.tls.yml
NGINX_CONF_FILE=gamad-hub.conf

STORAGE_DRIVER=local
STORAGE_PATH=./storage

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_DISPLAY_NAME=Super Admin GAMAD

BACKUP_RETENTION_DAYS=14
