# ─── Environnement ───────────────────────────────────────────────────────────
APP_ENV=development

# ─── Base de données ─────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://gamad_user:change_me@postgres:5432/gamad_hub
POSTGRES_DB=gamad_hub
POSTGRES_USER=gamad_user
POSTGRES_PASSWORD=change_me

# ─── Auth JWT ────────────────────────────────────────────────────────────────
# Générer avec: openssl rand -base64 48
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

# ─── Ports des services ──────────────────────────────────────────────────────
API_PORT=4000
CORE_PORT=3000
PORTAL_PORT=3001

# ─── URLs ────────────────────────────────────────────────────────────────────
# Utilisé pour les liens internes côté serveur (SSR)
INTERNAL_API_URL=http://api:4000/api
# Utilisé côté navigateur (même origine via Nginx)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# URL du CORE — utilisée par le portail pour le lien "Espace membre"
NEXT_PUBLIC_CORE_URL=http://hub.gamad.net

# ─── Nginx ───────────────────────────────────────────────────────────────────
# gamad-hub.conf = HTTP uniquement
# gamad-hub-tls.conf = HTTP + HTTPS (production avec Let's Encrypt)
NGINX_CONF_FILE=gamad-hub.conf

# ─── Stockage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./storage

# ─── Compte admin initial ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_DISPLAY_NAME=Super Admin GAMAD

# ─── Backup ──────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14

# ─── CORS ────────────────────────────────────────────────────────────────────
# Domaines autorisés séparés par virgule
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://gamad.net,https://hub.gamad.net
