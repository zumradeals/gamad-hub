generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum IdentityType {
  PERSON
  ORGANIZATION
  SYSTEM
}

enum IdentityStatus {
  PORTAL_USER
  PENDING
  ACTIVE
  MISSIONARY
  ILLUMINATED
  LIMITED
  SUSPENDED
  ARCHIVED
  BANNED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum ProfileVisibility {
  PUBLIC
  INTERNAL
  PRIVATE
}

enum RoleScope {
  GLOBAL
  UNIT
  MODULE
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  VALIDATE
  MANAGE
  EXPORT
  MODERATE
  ARCHIVE
  ASSIGN
  REVOKE
  AUDIT
}

enum OrganizationUnitType {
  HCG
  DEPARTMENT
  COORDINATION
  SECTION
  ZUMARA
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipType {
  MEMBER
  RESPONSIBLE
  ASSISTANT
  OBSERVER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ZumaraVisibility {
  PUBLIC
  INTERNAL
  PRIVATE
  CORE
}

enum ZumaraType {
  LOCAL
  DIGITAL
  HYBRID
}

enum ZumaraRequestStatus {
  SUBMITTED
  PRE_VALIDATED
  IN_FORMATION
  ACTIVE
  REJECTED
  EXPIRED
}

enum ZumaraStatus {
  ACTIVE
  ESTABLISHED
  SATELLITE
  ELITE
  SUSPENDED
  DISSOLVED
}

enum ZumaraMemberRole {
  FOUNDER
  CO_FOUNDER
  MEMBER
  OBSERVER
}

enum RevelationPath {
  DIRECT
  THRESHOLD
  SPONSORED
  CHOSEN
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ThreadVisibility {
  PUBLIC
  INTERNAL
  UNIT
  PRIVATE
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  ARCHIVED
}

enum AnnouncementAudience {
  PUBLIC
  INTERNAL
  UNIT
  ROLE
}

enum ActivityStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ActivityPriority {
  LOW
  NORMAL
  HIGH
  STRATEGIC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum DocumentType {
  STATUTE
  REPORT
  MANUAL
  PROCEDURE
  MEDIA
  ARCHIVE
  TRAINING
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  STRATEGIC
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  ARCHIVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportReason {
  SPAM
  HATE_SPEECH
  MISINFORMATION
  HARASSMENT
  INAPPROPRIATE_CONTENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  VALIDATED
  DISMISSED
}

enum FilterSeverity {
  BLOCK
  FLAG
}

enum ZahabTransactionReason {
  CONTENT_PUBLISHED
  CONTENT_REWARD
  COMMENT_REWARD
  REACTION_RECEIVED
  REFERRAL
  COTISATION_PAYMENT
  REGISTRATION_BONUS
  MANUAL_CREDIT
  MANUAL_DEBIT
  CONVERSION_REQUEST
  ARTICLE_PUBLISHED
  ARTICLE_MILESTONE_100
  ARTICLE_MILESTONE_1K
  ARTICLE_READ
  ARTICLE_LIKED
  MARKET_PURCHASE
  VIDEO_WATCHED
  VIDEO_LIKED
  VIDEO_PUBLISHED
  VIDEO_MILESTONE_100
  VIDEO_MILESTONE_1K
  VIDEO_MILESTONE_10K
}

enum TrustLevel {
  NEWCOMER
  MEMBER
  TRUSTED
  VETERAN
  GUARDIAN
}

// ─── IDENTITY ─────────────────────────────────────────────────────────────────

model GamadId {
  id           String         @id @default(uuid())
  publicCode   String         @unique
  identityType IdentityType   @default(PERSON)
  status       IdentityStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  account                Account?
  profile                Profile?
  memberRoles            MemberRole[]
  memberships            Membership[]
  ownedActivities        Activity[]            @relation("ActivityOwner")
  assignedTasks          Task[]                @relation("TaskAssignee")
  ownedDocuments         Document[]            @relation("DocumentOwner")
  sentMessages           Message[]             @relation("MessageSender")
  receivedMessages       Message[]             @relation("MessageRecipient")
  notifications          Notification[]
  auditEvents            AuditEvent[]          @relation("AuditActor")
  documentVersions       DocumentVersion[]     @relation("VersionCreator")
  grantedRoles           MemberRole[]          @relation("RoleGranter")
  enrollments            FormationEnrollment[]
  moduleCompletions      ModuleCompletion[]
  posts                  Post[]
  reactions              PostReaction[]
  publishedAnnouncements Announcement[]
  activityReports        ActivityReport[]
  portalApplications     PortalApplication[]
  feedPosts              PortalFeedPost[]
  feedReactions          PortalFeedReaction[]
  feedComments           PortalFeedComment[]
  zahabWallet            ZahabWallet?
  reputation             ReputationScore?
  sentZahab              ZahabTransaction[]    @relation("ZahabSender")
  receivedZahab          ZahabTransaction[]    @relation("ZahabReceiver")
  articles               Article[]             @relation("ArticleAuthor")
  reportsMade            ContentReport[]       @relation("ReportsMade")
  reportsReviewed        ContentReport[]       @relation("ReportsReviewed")

  zumaraRequests        ZumaraRequest[]        @relation("ZumaraRequests")
  zumaraFounderships    ZumaraFounder[]        @relation("ZumaraFounderships")
  zumaraCellMemberships ZumaraCellMembership[] @relation("ZumaraCellMemberships")
  revelationEvents      RevelationEvent[]      @relation("RevelationEvents")
  pageFollows           ZumaraPageFollow[]
  marketOrders          MarketOrder[]          @relation("MarketOrderBuyer")
  articleReads          ArticleRead[]          @relation("ArticleReads")
  articleLikes          ArticleLike[]          @relation("ArticleLikes")
  articleComments       ArticleComment[]       @relation("ArticleComments")
  moduleRoles           ModuleRole[]           @relation("ModuleRoles")
  videoAuthored         GamadTubeVideo[]       @relation("VideoAuthor")
  videoChannels         VideoChannel[]         @relation("ChannelOwner")
  videoWatches          VideoWatch[]           @relation("VideoWatches")
  videoLikes            VideoLike[]            @relation("VideoLikes")
  videoComments         VideoComment[]         @relation("VideoComments")
}

model Account {
  id           String        @id @default(uuid())
  gamadId      String        @unique
  gamad        GamadId       @relation(fields: [gamadId], references: [id])
  email        String        @unique
  phone        String?
  passwordHash String
  mfaEnabled   Boolean       @default(false)
  lastLoginAt  DateTime?
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Profile {
  id          String            @id @default(uuid())
  gamadId     String            @unique
  gamad       GamadId           @relation(fields: [gamadId], references: [id])
  firstName   String?
  lastName    String?
  displayName String
  avatarUrl   String?
  bio         String?
  birthDate   DateTime?
  country     String?
  city        String?
  visibility  ProfileVisibility @default(INTERNAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Role {
  id           String    @id @default(uuid())
  name         String    @unique
  scope        RoleScope @default(GLOBAL)
  description  String?
  isSystemRole Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rolePermissions RolePermission[]
  memberRoles     MemberRole[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model MemberRole {
  id                 String            @id @default(uuid())
  gamadId            String
  gamad              GamadId           @relation(fields: [gamadId], references: [id])
  roleId             String
  role               Role              @relation(fields: [roleId], references: [id])
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  grantedBy          String?
  granter            GamadId?          @relation("RoleGranter", fields: [grantedBy], references: [id])
  grantedAt          DateTime          @default(now())
  revokedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// ─── ORGANIZATION ─────────────────────────────────────────────────────────────

model OrganizationUnit {
  id          String                 @id @default(uuid())
  name        String
  type        OrganizationUnitType
  parentId    String?
  parent      OrganizationUnit?      @relation("UnitHierarchy", fields: [parentId], references: [id])
  children    OrganizationUnit[]     @relation("UnitHierarchy")
  status      OrganizationUnitStatus @default(ACTIVE)
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  zumara        Zumara?
  memberships   Membership[]
  memberRoles   MemberRole[]
  activities    Activity[]
  documents     Document[]
  announcements Announcement[]
  messages      Message[]
  auditEvents   AuditEvent[]
  threads       Thread[]
}

model Membership {
  id                 String           @id @default(uuid())
  gamadId            String
  gamad              GamadId          @relation(fields: [gamadId], references: [id])
  organizationUnitId String
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])
  membershipType     MembershipType   @default(MEMBER)
  status             MembershipStatus @default(PENDING)
  joinedAt           DateTime         @default(now())
  leftAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Zumara {
  id                 String           @id @default(uuid())
  organizationUnitId String           @unique
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])
  activityDomain     String?
  mission            String?
  visibility         ZumaraVisibility @default(INTERNAL)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ─── FORMATION ────────────────────────────────────────────────────────────────

model Formation {
  id          String          @id @default(uuid())
  title       String
  description String?
  slug        String          @unique
  imageUrl    String?
  isPublic    Boolean         @default(false)
  status      FormationStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  modules     FormationModule[]
  enrollments FormationEnrollment[]
}

model FormationModule {
  id          String    @id @default(uuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id])
  title       String
  description String?
  order       Int       @default(0)
  durationMin Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  completions ModuleCompletion[]
}

model FormationEnrollment {
  id          String           @id @default(uuid())
  gamadId     String
  gamad       GamadId          @relation(fields: [gamadId], references: [id])
  formationId String
  formation   Formation        @relation(fields: [formationId], references: [id])
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([gamadId, formationId])
}

model ModuleCompletion {
  id          String          @id @default(uuid())
  gamadId     String
  gamad       GamadId         @relation(fields: [gamadId], references: [id])
  moduleId    String
  module      FormationModule @relation(fields: [moduleId], references: [id])
  completedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([gamadId, moduleId])
}

// ─── COMMUNICATION ────────────────────────────────────────────────────────────

model Thread {
  id                 String            @id @default(uuid())
  title              String
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  visibility         ThreadVisibility  @default(INTERNAL)
  isPinned           Boolean           @default(false)
  isLocked           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  posts Post[]
}

model Post {
  id        String     @id @default(uuid())
  threadId  String
  thread    Thread     @relation(fields: [threadId], references: [id])
  authorId  String
  author    GamadId    @relation(fields: [authorId], references: [id])
  content   String
  status    PostStatus @default(PUBLISHED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reactions PostReaction[]
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  gamadId   String
  gamad     GamadId  @relation(fields: [gamadId], references: [id])
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, gamadId, emoji])
}

model Announcement {
  id                 String               @id @default(uuid())
  title              String
  content            String
  organizationUnitId String?
  organizationUnit   OrganizationUnit?    @relation(fields: [organizationUnitId], references: [id])
  audienceScope      AnnouncementAudience @default(INTERNAL)
  publishedBy        String
  publisher          GamadId              @relation(fields: [publishedBy], references: [id])
  publishedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Message {
  id                 String            @id @default(uuid())
  senderId           String
  sender             GamadId           @relation("MessageSender", fields: [senderId], references: [id])
  recipientId        String
  recipient          GamadId           @relation("MessageRecipient", fields: [recipientId], references: [id])
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  content            String
  status             MessageStatus     @default(SENT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  gamadId   String
  gamad     GamadId   @relation(fields: [gamadId], references: [id])
  type      String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── ACTIVITY ─────────────────────────────────────────────────────────────────

model Activity {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  ownerId            String
  owner              GamadId           @relation("ActivityOwner", fields: [ownerId], references: [id])
  status             ActivityStatus    @default(DRAFT)
  priority           ActivityPriority  @default(NORMAL)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tasks   Task[]
  reports ActivityReport[]
}

model Task {
  id          String     @id @default(uuid())
  activityId  String
  activity    Activity   @relation(fields: [activityId], references: [id])
  title       String
  description String?
  assignedTo  String?
  assignee    GamadId?   @relation("TaskAssignee", fields: [assignedTo], references: [id])
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ActivityReport {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  authorId   String
  author     GamadId  @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── KNOWLEDGE ────────────────────────────────────────────────────────────────

model Document {
  id                 String                 @id @default(uuid())
  title              String
  documentType       DocumentType           @default(MANUAL)
  classification     DocumentClassification @default(INTERNAL)
  organizationUnitId String?
  organizationUnit   OrganizationUnit?      @relation(fields: [organizationUnitId], references: [id])
  ownerId            String
  owner              GamadId                @relation("DocumentOwner", fields: [ownerId], references: [id])
  status             DocumentStatus         @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  versions DocumentVersion[]
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  versionNumber String
  fileUrl       String
  checksum      String?
  createdBy     String
  creator       GamadId  @relation("VersionCreator", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── COTISATION ───────────────────────────────────────────────────────────────

model CotisationPeriod {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  amount    Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments CotisationPayment[]
}

model CotisationPayment {
  id        String           @id @default(uuid())
  gamadId   String
  periodId  String
  period    CotisationPeriod @relation(fields: [periodId], references: [id])
  amount    Float
  currency  String           @default("XOF")
  reference String?
  paidAt    DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ─── AUDIT (APPEND-ONLY) ──────────────────────────────────────────────────────

model AuditEvent {
  id                 String            @id @default(uuid())
  actorId            String?
  actor              GamadId?          @relation("AuditActor", fields: [actorId], references: [id])
  action             String
  targetType         String
  targetId           String?
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  oldValue           Json?
  newValue           Json?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime          @default(now())
}

// ─── PORTAIL PUBLIC ───────────────────────────────────────────────────────────

model ArticleCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

model Article {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  excerpt          String?
  content          String
  contentBlocks    Json?
  imageUrl         String?
  videoUrl         String?
  tags             String[]
  sponsored        Boolean          @default(false)
  sponsorName      String?
  sponsorUrl       String?
  categoryId       String?
  category         ArticleCategory? @relation(fields: [categoryId], references: [id])
  authorId         String?
  author           GamadId?         @relation("ArticleAuthor", fields: [authorId], references: [id])
  editorId         String?
  status           ArticleStatus    @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  rejectionNote    String?
  zahabRewarded    Boolean          @default(false)
  rewardAmount     Float            @default(0)
  viewCount        Int              @default(0)
  readRewardCount  Int              @default(0)
  likesCount       Int              @default(0)
  readingTimeMin   Int?
  milestone100     Boolean          @default(false)
  milestone1k      Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reads            ArticleRead[]
  likes            ArticleLike[]
  comments         ArticleComment[]
}

model VideoCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]
  tubeVideos GamadTubeVideo[]
}

model Video {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  description  String?
  thumbnailUrl String?
  videoUrl     String?
  duration     Int?
  categoryId   String?
  category     VideoCategory? @relation(fields: [categoryId], references: [id])
  status       VideoStatus    @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── PORTAIL — CANDIDATURES RÉSEAU ───────────────────────────────────────────

model PortalApplication {
  id                 String            @id @default(uuid())
  gamadId            String?
  gamad              GamadId?          @relation(fields: [gamadId], references: [id])
  firstName          String
  lastName           String
  email              String
  country            String?
  city               String?
  message            String?
  status             ApplicationStatus @default(SUBMITTED)
  reviewNote         String?
  reviewedAt         DateTime?
  advancedFormSentAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// ─── PORTAIL — FEED SOCIAL ────────────────────────────────────────────────────

enum FeedPostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

model PortalFeedPost {
  id               String           @id @default(uuid())
  gamadId          String
  gamad            GamadId          @relation(fields: [gamadId], references: [id])
  cellId           String?
  cell             ZumaraCell?      @relation(fields: [cellId], references: [id])
  content          String
  contentBlocks    Json?
  mediaUrls        Json?
  status           FeedPostStatus   @default(PUBLISHED)
  moderationStatus ModerationStatus @default(APPROVED)
  zahabRewarded    Boolean          @default(false)
  rewardAmount     Float            @default(0)
  viewCount        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reactions PortalFeedReaction[]
  comments  PortalFeedComment[]
}

model PortalFeedReaction {
  id        String         @id @default(uuid())
  postId    String
  post      PortalFeedPost @relation(fields: [postId], references: [id])
  gamadId   String
  gamad     GamadId        @relation(fields: [gamadId], references: [id])
  emoji     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([postId, gamadId, emoji])
}

model PortalFeedComment {
  id        String         @id @default(uuid())
  postId    String
  post      PortalFeedPost @relation(fields: [postId], references: [id])
  gamadId   String
  gamad     GamadId        @relation(fields: [gamadId], references: [id])
  content   String         @db.VarChar(500)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ─── ZAHAB — MONNAIE CIVILISATIONNELLE ───────────────────────────────────────

model ZahabWallet {
  id           String   @id @default(uuid())
  gamadId      String   @unique
  gamad        GamadId  @relation(fields: [gamadId], references: [id])
  balance      Float    @default(0)
  lockedAmount Float    @default(0)
  totalEarned  Float    @default(0)
  totalSpent   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ZahabTransaction {
  id          String                 @id @default(uuid())
  fromId      String?
  from        GamadId?               @relation("ZahabSender", fields: [fromId], references: [id])
  toId        String
  to          GamadId                @relation("ZahabReceiver", fields: [toId], references: [id])
  amount      Float
  reason      ZahabTransactionReason
  referenceId String?
  note        String?
  createdAt   DateTime               @default(now())
}

// ─── RÉPUTATION ───────────────────────────────────────────────────────────────

model ReputationScore {
  id              String     @id @default(uuid())
  gamadId         String     @unique
  gamad           GamadId    @relation(fields: [gamadId], references: [id])
  score           Int        @default(0)
  contentScore    Int        @default(0)
  engagementScore Int        @default(0)
  trustLevel      TrustLevel @default(NEWCOMER)
  totalPosts      Int        @default(0)
  totalComments   Int        @default(0)
  totalReactions  Int        @default(0)
  totalReported   Int        @default(0)
  totalFlagged    Int        @default(0)
  updatedAt       DateTime   @updatedAt
}

// ─── MODÉRATION ───────────────────────────────────────────────────────────────

model ContentReport {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    GamadId      @relation("ReportsMade", fields: [reporterId], references: [id])
  contentId   String
  contentType String
  reason      ReportReason
  note        String?
  status      ReportStatus @default(PENDING)
  reviewerId  String?
  reviewer    GamadId?     @relation("ReportsReviewed", fields: [reviewerId], references: [id])
  reviewNote  String?
  createdAt   DateTime     @default(now())
  reviewedAt  DateTime?

  @@unique([reporterId, contentId, contentType])
}

model ContentFilterRule {
  id        String         @id @default(uuid())
  keyword   String         @unique
  severity  FilterSeverity @default(FLAG)
  createdAt DateTime       @default(now())
  createdBy String
}

// ─── ZUMARA — CELLULES CERTIFIÉES GAMAD ──────────────────────────────────────

model ZumaraRequest {
  id          String              @id @default(uuid())
  gamadId     String
  gamad       GamadId             @relation("ZumaraRequests", fields: [gamadId], references: [id])
  name        String
  objective   String
  type        ZumaraType          @default(HYBRID)
  country     String?
  city        String?
  status      ZumaraRequestStatus @default(SUBMITTED)
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  deadline    DateTime?
  activatedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  founders ZumaraFounder[]
  cell     ZumaraCell?
}

model ZumaraFounder {
  id        String           @id @default(uuid())
  requestId String
  request   ZumaraRequest    @relation(fields: [requestId], references: [id])
  gamadId   String?
  gamad     GamadId?         @relation("ZumaraFounderships", fields: [gamadId], references: [id])
  email     String
  role      ZumaraMemberRole @default(CO_FOUNDER)
  trained   Boolean          @default(false)
  joinedAt  DateTime         @default(now())

  @@unique([requestId, email])
}

model ZumaraCell {
  id               String           @id @default(uuid())
  requestId        String           @unique
  request          ZumaraRequest    @relation(fields: [requestId], references: [id])
  name             String
  slug             String           @unique
  objective        String
  type             ZumaraType
  country          String?
  city             String?
  status           ZumaraStatus     @default(ACTIVE)
  visibility       ZumaraVisibility @default(PUBLIC)
  memberCount      Int              @default(5)
  cotisationAmount Float?
  cotisationPeriod String?
  walletBalance    Float            @default(0)
  activatedAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  memberships ZumaraCellMembership[]
  feedPosts   PortalFeedPost[]
  page        ZumaraPage?
}

model ZumaraCellMembership {
  id       String           @id @default(uuid())
  cellId   String
  cell     ZumaraCell       @relation(fields: [cellId], references: [id])
  gamadId  String
  gamad    GamadId          @relation("ZumaraCellMemberships", fields: [gamadId], references: [id])
  role     ZumaraMemberRole @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  leftAt   DateTime?

  @@unique([cellId, gamadId])
}

// ─── RÉVÉLATION — ACCÈS CORE ─────────────────────────────────────────────────

model RevelationEvent {
  id        String         @id @default(uuid())
  gamadId   String
  gamad     GamadId        @relation("RevelationEvents", fields: [gamadId], references: [id])
  path      RevelationPath
  actorId   String?
  note      String?
  grantedAt DateTime       @default(now())
}

// ─── PAGES PRO — MARQUE & COMMERCE ──────────────────────────────────────────

enum PageStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PageProductType {
  PRODUCT
  SERVICE
}

model ZumaraPage {
  id          String     @id @default(uuid())
  cellId      String     @unique
  cell        ZumaraCell @relation(fields: [cellId], references: [id])
  name        String
  slug        String     @unique
  tagline     String?
  description String?
  logoUrl     String?
  coverUrl    String?
  category    String?
  website     String?
  email       String?
  country     String?
  city        String?
  status      PageStatus @default(ACTIVE)
  followCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  posts     ZumaraPagePost[]
  products  ZumaraPageProduct[]
  followers ZumaraPageFollow[]
}

model ZumaraPagePost {
  id        String     @id @default(uuid())
  pageId    String
  page      ZumaraPage @relation(fields: [pageId], references: [id])
  content   String
  imageUrl  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ZumaraPageProduct {
  id          String          @id @default(uuid())
  pageId      String
  page        ZumaraPage      @relation(fields: [pageId], references: [id])
  name        String
  description String?
  imageUrl    String?
  price       Float?
  currency    String          @default("ZAHAB")
  type        PageProductType @default(SERVICE)
  available   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orders      MarketOrder[]
}

model ZumaraPageFollow {
  id        String     @id @default(uuid())
  pageId    String
  page      ZumaraPage @relation(fields: [pageId], references: [id])
  gamadId   String
  gamad     GamadId    @relation(fields: [gamadId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pageId, gamadId])
}

enum MarketOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MarketPaymentMethod {
  ZAHAB
  WAVE
  ORANGE_MONEY
}

model MarketOrder {
  id            String              @id @default(uuid())
  productId     String
  product       ZumaraPageProduct   @relation(fields: [productId], references: [id])
  buyerGamadId  String
  buyer         GamadId             @relation("MarketOrderBuyer", fields: [buyerGamadId], references: [id])
  quantity      Int                 @default(1)
  unitPrice     Float
  totalPrice    Float
  currency      String              @default("ZAHAB")
  paymentMethod MarketPaymentMethod @default(ZAHAB)
  status        MarketOrderStatus   @default(PENDING)
  note          String?
  paymentRef    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// ─── BLOG ENGAGEMENT ─────────────────────────────────────────────────────────

model ArticleRead {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id])
  gamadId     String
  gamad       GamadId  @relation("ArticleReads", fields: [gamadId], references: [id])
  rewardedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([articleId, gamadId])
}

model ArticleLike {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  gamadId   String
  gamad     GamadId  @relation("ArticleLikes", fields: [gamadId], references: [id])
  createdAt DateTime @default(now())

  @@unique([articleId, gamadId])
}

model ArticleComment {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  gamadId   String
  gamad     GamadId  @relation("ArticleComments", fields: [gamadId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── MODULE SOVEREIGNTY ───────────────────────────────────────────────────────

model ModuleConfig {
  id        String   @id @default(uuid())
  module    String
  key       String
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([module, key])
}

model ModuleRole {
  id          String   @id @default(uuid())
  module      String
  gamadId     String
  gamad       GamadId  @relation("ModuleRoles", fields: [gamadId], references: [id])
  role        String
  grantedBy   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, gamadId, role])
}

// ─── GAMADTUBE ────────────────────────────────────────────────────────────────


model VideoChannel {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  avatarUrl   String?
  bannerUrl   String?
  isOfficial  Boolean          @default(false)
  gamadId     String?
  gamad       GamadId?         @relation("ChannelOwner", fields: [gamadId], references: [id])
  videos      GamadTubeVideo[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model GamadTubeVideo {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  description      String?
  youtubeUrl       String
  thumbnailUrl     String?
  categoryId       String?
  category         VideoCategory?   @relation(fields: [categoryId], references: [id])
  tags             String[]
  durationMin      Int?
  authorId         String?
  author           GamadId?         @relation("VideoAuthor", fields: [authorId], references: [id])
  channelId        String?
  channel          VideoChannel?    @relation(fields: [channelId], references: [id])
  sponsored        Boolean          @default(false)
  sponsorName      String?
  sponsorUrl       String?
  verified         Boolean          @default(false)
  status           VideoStatus      @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  editorId         String?
  rejectionNote    String?
  viewCount        Int              @default(0)
  likesCount       Int              @default(0)
  watchRewardCount Int              @default(0)
  milestone100     Boolean          @default(false)
  milestone1k      Boolean          @default(false)
  milestone10k     Boolean          @default(false)
  zahabRewarded    Boolean          @default(false)
  rewardAmount     Float            @default(0)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  watches          VideoWatch[]
  likes            VideoLike[]
  comments         VideoComment[]
}

model VideoWatch {
  id        String         @id @default(uuid())
  videoId   String
  video     GamadTubeVideo @relation(fields: [videoId], references: [id])
  gamadId   String
  gamad     GamadId        @relation("VideoWatches", fields: [gamadId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([videoId, gamadId])
}

model VideoLike {
  id        String         @id @default(uuid())
  videoId   String
  video     GamadTubeVideo @relation(fields: [videoId], references: [id])
  gamadId   String
  gamad     GamadId        @relation("VideoLikes", fields: [gamadId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([videoId, gamadId])
}

model VideoComment {
  id        String         @id @default(uuid())
  videoId   String
  video     GamadTubeVideo @relation(fields: [videoId], references: [id])
  gamadId   String
  gamad     GamadId        @relation("VideoComments", fields: [gamadId], references: [id])
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}
