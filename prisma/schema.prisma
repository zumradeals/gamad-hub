generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityType {
  PERSON
  ORGANIZATION
  SYSTEM
}

enum IdentityStatus {
  PENDING
  ACTIVE
  LIMITED
  SUSPENDED
  ARCHIVED
  BANNED
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum RoleScope {
  GLOBAL
  UNIT
  MODULE
}

enum OrganizationUnitType {
  HCG
  DEPARTMENT
  COORDINATION
  SECTION
  ZUMARA
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipType {
  MEMBER
  RESPONSIBLE
  ASSISTANT
  OBSERVER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ActivityStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ActivityPriority {
  LOW
  NORMAL
  HIGH
  STRATEGIC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowTargetType {
  ACTIVITY
  DOCUMENT
  MEMBERSHIP
}

enum WorkflowActionRequired {
  APPROVE
  REJECT
  REVIEW
}

enum DocumentType {
  STATUTE
  REPORT
  MANUAL
  PROCEDURE
  MEDIA
  ARCHIVE
  TRAINING
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  STRATEGIC
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  ARCHIVED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  ARCHIVED
}

enum ProfileVisibility {
  PUBLIC
  INTERNAL
  PRIVATE
  RESTRICTED
}

enum AnnouncementAudienceScope {
  PUBLIC
  INTERNAL
  UNIT
  ROLE
}

model GamadId {
  id           String         @id @default(uuid()) @db.Uuid
  publicCode   String         @unique @map("public_code")
  identityType IdentityType   @map("identity_type")
  status       IdentityStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  accounts              Account[]
  profile               Profile?
  memberRoles           MemberRole[]        @relation("MemberRoleIdentity")
  grantedRoles          MemberRole[]        @relation("MemberRoleGrantor")
  memberships           Membership[]
  ownedActivities       Activity[]          @relation("ActivityOwner")
  assignedTasks         Task[]              @relation("TaskAssignee")
  ownedDocuments        Document[]          @relation("DocumentOwner")
  createdDocumentVersions DocumentVersion[] @relation("DocumentVersionCreator")
  sentMessages          Message[]           @relation("MessageSender")
  receivedMessages      Message[]           @relation("MessageRecipient")
  publishedAnnouncements Announcement[]     @relation("AnnouncementPublisher")
  notifications         Notification[]
  auditEvents           AuditEvent[]        @relation("AuditActor")

  @@map("gamad_ids")
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  gamadId       String        @map("gamad_id") @db.Uuid
  email         String        @unique
  phone         String?
  passwordHash  String        @map("password_hash")
  mfaEnabled    Boolean       @default(false) @map("mfa_enabled")
  lastLoginAt   DateTime?     @map("last_login_at")
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  gamadIdentity GamadId @relation(fields: [gamadId], references: [id], onDelete: Restrict)

  @@index([gamadId])
  @@map("accounts")
}

model Profile {
  id          String            @id @default(uuid()) @db.Uuid
  gamadId     String            @unique @map("gamad_id") @db.Uuid
  firstName   String?           @map("first_name")
  lastName    String?           @map("last_name")
  displayName String            @map("display_name")
  avatarUrl   String?           @map("avatar_url")
  bio         String?
  birthDate   DateTime?         @map("birth_date") @db.Date
  country     String?
  city        String?
  visibility  ProfileVisibility @default(INTERNAL)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  gamadIdentity GamadId @relation(fields: [gamadId], references: [id], onDelete: Restrict)

  @@map("profiles")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  scope        RoleScope
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  memberRoles     MemberRole[]
  workflowSteps   WorkflowStep[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  id                 String    @id @default(uuid()) @db.Uuid
  gamadId            String    @map("gamad_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  organizationUnitId String?   @map("organization_unit_id") @db.Uuid
  grantedBy          String?   @map("granted_by") @db.Uuid
  grantedAt          DateTime  @default(now()) @map("granted_at")
  revokedAt          DateTime? @map("revoked_at")

  gamadIdentity   GamadId           @relation("MemberRoleIdentity", fields: [gamadId], references: [id], onDelete: Restrict)
  role            Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  grantor         GamadId?          @relation("MemberRoleGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@index([gamadId])
  @@index([roleId])
  @@index([organizationUnitId])
  @@map("member_roles")
}

model OrganizationUnit {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String
  type        OrganizationUnitType
  parentId    String?                @map("parent_id") @db.Uuid
  status      OrganizationUnitStatus @default(ACTIVE)
  description String?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  parent        OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      OrganizationUnit[] @relation("OrganizationHierarchy")
  memberships   Membership[]
  zumara        Zumara?
  memberRoles   MemberRole[]
  activities    Activity[]
  documents     Document[]
  messages      Message[]
  announcements Announcement[]
  auditEvents   AuditEvent[]

  @@index([parentId])
  @@index([type, status])
  @@map("organization_units")
}

model Membership {
  id                 String           @id @default(uuid()) @db.Uuid
  gamadId            String           @map("gamad_id") @db.Uuid
  organizationUnitId String           @map("organization_unit_id") @db.Uuid
  membershipType     MembershipType   @map("membership_type")
  status             MembershipStatus @default(PENDING)
  joinedAt           DateTime?        @map("joined_at")
  leftAt             DateTime?        @map("left_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  gamadIdentity   GamadId          @relation(fields: [gamadId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  @@index([gamadId])
  @@index([organizationUnitId])
  @@map("memberships")
}

model Zumara {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationUnitId String            @unique @map("organization_unit_id") @db.Uuid
  activityDomain     String            @map("activity_domain")
  mission            String?
  visibility         ProfileVisibility @default(INTERNAL)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  @@map("zumara")
}

model Activity {
  id                 String           @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  organizationUnitId String           @map("organization_unit_id") @db.Uuid
  ownerId            String           @map("owner_id") @db.Uuid
  status             ActivityStatus   @default(DRAFT)
  priority           ActivityPriority @default(NORMAL)
  startDate          DateTime?        @map("start_date") @db.Date
  endDate            DateTime?        @map("end_date") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  owner            GamadId          @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks            Task[]

  @@index([organizationUnitId])
  @@index([ownerId])
  @@index([status])
  @@map("activities")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  activityId  String     @map("activity_id") @db.Uuid
  title       String
  description String?
  assignedTo  String?    @map("assigned_to") @db.Uuid
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @map("due_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assignee GamadId? @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([assignedTo])
  @@map("tasks")
}

model Workflow {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  targetType WorkflowTargetType @map("target_type")
  status     WorkflowStatus     @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  steps WorkflowStep[]

  @@map("workflows")
}

model WorkflowStep {
  id             String                 @id @default(uuid()) @db.Uuid
  workflowId     String                 @map("workflow_id") @db.Uuid
  stepOrder      Int                    @map("step_order")
  requiredRoleId String                 @map("required_role_id") @db.Uuid
  actionRequired WorkflowActionRequired @map("action_required")
  createdAt      DateTime               @default(now()) @map("created_at")

  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  requiredRole Role     @relation(fields: [requiredRoleId], references: [id], onDelete: Restrict)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

model Document {
  id                 String                 @id @default(uuid()) @db.Uuid
  title              String
  documentType       DocumentType           @map("document_type")
  classification     DocumentClassification @default(INTERNAL)
  organizationUnitId String?                @map("organization_unit_id") @db.Uuid
  ownerId            String                 @map("owner_id") @db.Uuid
  status             DocumentStatus         @default(DRAFT)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  owner            GamadId           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]

  @@index([organizationUnitId])
  @@index([ownerId])
  @@index([classification, status])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNumber String   @map("version_number")
  fileUrl       String   @map("file_url")
  checksum      String
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  creator  GamadId  @relation("DocumentVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([createdBy])
  @@map("document_versions")
}

model Message {
  id                 String        @id @default(uuid()) @db.Uuid
  senderId           String        @map("sender_id") @db.Uuid
  recipientId        String        @map("recipient_id") @db.Uuid
  organizationUnitId String?       @map("organization_unit_id") @db.Uuid
  content            String
  status             MessageStatus @default(SENT)
  createdAt          DateTime      @default(now()) @map("created_at")

  sender           GamadId           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient        GamadId           @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

model Announcement {
  id                 String                    @id @default(uuid()) @db.Uuid
  title              String
  content            String
  organizationUnitId String?                   @map("organization_unit_id") @db.Uuid
  audienceScope      AnnouncementAudienceScope @map("audience_scope")
  publishedBy        String                    @map("published_by") @db.Uuid
  publishedAt        DateTime?                 @map("published_at")
  createdAt          DateTime                  @default(now()) @map("created_at")

  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  publisher        GamadId           @relation("AnnouncementPublisher", fields: [publishedBy], references: [id], onDelete: Restrict)

  @@index([organizationUnitId])
  @@index([publishedBy])
  @@map("announcements")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  gamadId   String    @map("gamad_id") @db.Uuid
  type      String
  content   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  gamadIdentity GamadId @relation(fields: [gamadId], references: [id], onDelete: Restrict)

  @@index([gamadId])
  @@map("notifications")
}

model AuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String?  @map("actor_id") @db.Uuid
  action             String
  targetType         String   @map("target_type")
  targetId           String?  @map("target_id") @db.Uuid
  organizationUnitId String?  @map("organization_unit_id") @db.Uuid
  oldValue           Json?    @map("old_value")
  newValue           Json?    @map("new_value")
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  correlationId      String?  @map("correlation_id")
  causationId        String?  @map("causation_id")
  createdAt          DateTime @default(now()) @map("created_at")

  actor            GamadId?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([organizationUnitId])
  @@index([createdAt])
  @@map("audit_events")
}
